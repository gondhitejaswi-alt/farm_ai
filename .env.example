# ============================================================
# FARM AI - API KEYS
# Your keys are already pre-filled below!
# Just copy this to .env and you get REAL data
# ============================================================

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweather_api_key_here

# data.gov.in Mandi Price API
DATA_GOV_KEY=your_data_gov_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Set to false for real data
DEMO_MODE=false

# WhatsApp Alerts (optional - Rs 0.50/message)
# Get from https://www.twilio.com
TWILIO_ACCOUNT_SID=your_sid_here
TWILIO_AUTH_TOKEN=your_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
